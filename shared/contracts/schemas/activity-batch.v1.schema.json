{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://digitalpulse.local/contracts/activity-batch.v1.schema.json",
  "title": "ActivityEventBatch (v1)",
  "description": "Request body for POST /api/v1/activity/events/batch. The device block allows local auto-registration of collectors in Stage 1.",
  "type": "object",
  "additionalProperties": false,
  "required": ["device", "events"],
  "properties": {
    "device": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "name", "platform"],
      "properties": {
        "id": { "type": "string", "format": "uuid" },
        "kind": { "type": "string", "enum": ["desktop_agent", "browser_extension"] },
        "name": { "type": "string", "minLength": 1, "maxLength": 128 },
        "platform": { "type": "string", "minLength": 1, "maxLength": 64 },
        "browser": { "type": "string", "enum": ["chrome", "edge"] },
        "agentVersion": { "type": "string", "maxLength": 32 }
      }
    },
    "events": {
      "type": "array",
      "minItems": 1,
      "maxItems": 500,
      "items": { "$ref": "https://digitalpulse.local/contracts/activity-event.v1.schema.json" }
    }
  }
}

