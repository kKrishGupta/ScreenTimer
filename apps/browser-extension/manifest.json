{
  "manifest_version": 3,
  "name": "DigitalPulse Activity Tracker",
  "version": "0.1.3",
  "description": "Privacy-conscious local website domain activity tracking for Chrome and Edge.",
  "permissions": [
    "tabs",
    "webNavigation",
    "idle",
    "storage",
    "alarms",
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "http://127.0.0.1:3001/*"
  ],
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "DigitalPulse Activity Tracker"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
