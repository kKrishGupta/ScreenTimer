{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DigitalPulse",
  "version": "0.2.0",
  "identifier": "com.digitalpulse.controlcenter",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{
      "label": "main",
      "title": "DigitalPulse Employee Control Center",
      "width": 1180,
      "height": 780,
      "minWidth": 920,
      "minHeight": 680,
      "center": true,
      "resizable": true,
      "fullscreen": false
    }],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "publisher": "DigitalPulse",
    "copyright": "Copyright DigitalPulse",
    "shortDescription": "Authorized employee monitoring control center",
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": false }
    }
  }
}
