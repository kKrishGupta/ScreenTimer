{
  "name": "digitalpulse",
  "version": "0.1.0",
  "private": true,
  "description": "DigitalPulse - Windows-first local digital activity monitoring platform (Stage 1 local MVP)",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20.19"
  },
  "workspaces": [
    "shared/contracts",
    "backend",
    "apps",
    "apps/dashboard",
    "apps/browser-extension"
  ],
  "scripts": {
    "dev": "npm run dev:dashboard",
    "start": "npm run dev:dashboard",
    "dev:backend": "npm run dev -w @digitalpulse/backend",
    "dev:dashboard": "npm run dev -w @digitalpulse/dashboard",
    "start:backend": "npm run start -w @digitalpulse/backend",
    "build:dashboard": "npm run build -w @digitalpulse/dashboard",
    "db:generate": "npm run db:generate -w @digitalpulse/backend",
    "db:migrate": "npm run db:migrate -w @digitalpulse/backend",
    "db:deploy": "npm run db:deploy -w @digitalpulse/backend",
    "db:seed": "npm run db:seed -w @digitalpulse/backend",
    "test:contracts": "npm test -w @digitalpulse/contracts",
    "test:backend": "npm test -w @digitalpulse/backend",
    "test:extension": "npm test -w @digitalpulse/browser-extension",
    "extension:local": "node scripts/configure-browser-extension.mjs --target=local",
    "extension:production": "node scripts/configure-browser-extension.mjs --target=production",
    "test:dashboard": "npm test -w @digitalpulse/dashboard",
    "test:js": "npm test --workspaces --if-present",
    "lint:dashboard": "npm run lint -w @digitalpulse/dashboard",
    "package:exe": "powershell -ExecutionPolicy Bypass -File scripts/build-exe-package.ps1",
    "package:employees": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package-employee-downloads.ps1 -Deployment Production",
    "package:extensions": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package-employee-downloads.ps1 -ExtensionsOnly -Overwrite -Deployment Production",
    "build:installer": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-windows-installer.ps1",
    "verify:windows-installer": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify-windows-installer.ps1",
    "verify:employee-downloads": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify-employee-downloads.ps1",
    "verify:employee-download-http": "node scripts/verify-employee-download-http.mjs"
  },
  "devDependencies": {
    "vite": "7.3.7"
  },
  "allowScripts": {
    "@prisma/engines@7.10.1": true,
    "prisma@7.10.1": true,
    "esbuild@0.28.2": true
  },
  "overrides": {
    "vite": "$vite"
  }
}
