import { DeviceService } from './devices.service.js';
import { normalizeRole, Roles } from '../auth/auth.service.js';
import { getMonitoringAuthorization } from './monitoring-authorization.js';
import { createRateLimiter } from '../../middleware/rate-limiter.js';

const TIME_RE = /^(?:[01]\d|2[0-3]):[0-5]\d$/;
const WORKING_DAYS = ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'];

async function readOwnMonitoringStatus(prisma, user) {
  if (!prisma?.user?.findUnique) {
    const error = new Error('Monitoring settings are unavailable');
    error.statusCode = 503;
    throw error;
  }
  const owner = await prisma.user.findUnique({
    where: { id: user.id },
    include: { organization: { select: {
      timezone: true,
      monitoringShiftStart: true,
      monitoringShiftEnd: true,
      monitoringWorkingDays: true,
      monitoringConfigUpdatedAt: true,
    } } },
  });
  if (!owner || owner.organizationId !== user.organizationId) {
    const error = new Error('Account or organization could not be verified');
    error.statusCode = 404;
    throw error;
  }
  const isOrganizationAdmin = normalizeRole(user.role) === Roles.ADMIN;
  const organizationHasSchedule = Boolean(
    owner.organization?.monitoringShiftStart && owner.organization?.monitoringShiftEnd,
  );
  const displayedSchedule = isOrganizationAdmin && organizationHasSchedule
    ? {
        shiftStart: owner.organization.monitoringShiftStart,
        shiftEnd: owner.organization.monitoringShiftEnd,
        workingDays: owner.organization.monitoringWorkingDays,
      }
    : {
        shiftStart: owner.shiftStart,
        shiftEnd: owner.shiftEnd,
        workingDays: owner.workingDays,
      };
  return {
    monitoring: getMonitoringAuthorization(owner),
    settings: {
      shiftStart: displayedSchedule.shiftStart || '',
      shiftEnd: displayedSchedule.shiftEnd || '',
      workingDays: displayedSchedule.workingDays || [],
      organizationTimezone: owner.organization?.timezone || '',
      organizationSchedule: {
        shiftStart: owner.organization?.monitoringShiftStart || '',
        shiftEnd: owner.organization?.monitoringShiftEnd || '',
        workingDays: owner.organization?.monitoringWorkingDays || [],
      },
      scheduleSource: isOrganizationAdmin ? 'organization' : owner.scheduleOverride ? 'employee_override' : 'organization',
      configurationUpdatedAt: owner.configurationUpdatedAt || owner.organization?.monitoringConfigUpdatedAt || null,
      adminAuthorized: owner.monitoringAuthorized === true,
      consentGranted: Boolean(owner.monitoringConsentAt && (!owner.monitoringConsentRevokedAt || owner.monitoringConsentRevokedAt < owner.monitoringConsentAt)),
    },
  };
}

export default async function devicesRoutes(app) {
  const deviceService = app.deviceService || new DeviceService(app.prisma, app.log);
  if (!app.deviceService) {
    app.decorate('deviceService', deviceService);
  }

  const authMiddleware = app.authMiddleware;
  const tokenCreationLimiter = createRateLimiter({ windowMs: 60_000, maxRequests: 10, excludedPaths: [] });
  const tokenConsumptionLimiter = createRateLimiter({ windowMs: 60_000, maxRequests: 20, excludedPaths: [] });

  app.get('/devices/my-monitoring-status', async (request, reply) => {
    try {
      return reply.send(await readOwnMonitoringStatus(app.prisma, request.user));
    } catch (error) {
      return reply.code(error.statusCode || 503).send({ error: { code: 'MONITORING_STATUS_UNAVAILABLE', message: error.message } });
    }
  });

  app.post('/devices/my-monitoring-consent', async (request, reply) => {
    const { consent } = request.body || {};
    if (typeof consent !== 'boolean') {
      return reply.code(400).send({ error: { code: 'INVALID_INPUT', message: 'consent must be true or false' } });
    }
    if (!app.prisma?.user?.updateMany) {
      return reply.code(503).send({ error: { code: 'STORAGE_UNAVAILABLE', message: 'Monitoring consent could not be saved' } });
    }
    const now = new Date();
    try {
      const persistConsent = async (tx) => {
        const changed = await tx.user.updateMany({
          where: { id: request.user.id, organizationId: request.user.organizationId },
          data: consent
            ? { monitoringConsentAt: now, monitoringConsentRevokedAt: null, monitoringConsentVersion: 'activity-monitoring-v1' }
            : { monitoringConsentRevokedAt: now },
        });
        if (changed.count !== 1) return 0;
        if (tx.auditLog?.create) await tx.auditLog.create({
          data: {
            organizationId: request.user.organizationId,
            action: consent ? 'ACTIVITY_MONITORING_CONSENT_GRANTED' : 'ACTIVITY_MONITORING_CONSENT_REVOKED',
            actor: request.user.email,
            details: { userId: request.user.id, version: 'activity-monitoring-v1' },
          },
        });
        return 1;
      };
      const changedCount = app.prisma.$transaction
        ? await app.prisma.$transaction(persistConsent)
        : await persistConsent(app.prisma);
      if (changedCount !== 1) return reply.code(404).send({ error: { code: 'NOT_FOUND', message: 'Account not found in this organization' } });
      return reply.send({ success: true, ...(await readOwnMonitoringStatus(app.prisma, request.user)) });
    } catch (error) {
      request.log.error({ err: error }, 'Failed to persist monitoring consent');
      return reply.code(503).send({ error: { code: 'CONSENT_SAVE_FAILED', message: 'Monitoring consent could not be saved' } });
    }
  });

  // Organization administrators explicitly approve or pause monitoring for
  // their own account. The organization and target are derived from the
  // authenticated session, so a caller cannot change another user's policy.
  app.patch('/devices/my-monitoring-authorization', {
    preHandler: [authMiddleware.requireRole(Roles.ADMIN)],
  }, async (request, reply) => {
    const { authorized } = request.body || {};
    if (typeof authorized !== 'boolean') {
      return reply.code(400).send({ error: { code: 'INVALID_INPUT', message: 'authorized must be true or false' } });
    }
    if (!request.user?.organizationId || !app.prisma?.user?.updateMany) {
      return reply.code(503).send({ error: { code: 'STORAGE_UNAVAILABLE', message: 'Monitoring authorization could not be saved' } });
    }
    try {
      const persist = async (tx) => {
        const changed = await tx.user.updateMany({
          where: { id: request.user.id, organizationId: request.user.organizationId },
          data: { monitoringAuthorized: authorized },
        });
        if (changed.count !== 1) return 0;
        if (tx.auditLog?.create) await tx.auditLog.create({
          data: {
            organizationId: request.user.organizationId,
            action: authorized ? 'ACTIVITY_MONITORING_ADMIN_AUTHORIZED' : 'ACTIVITY_MONITORING_ADMIN_AUTHORIZATION_REVOKED',
            actor: request.user.email,
            details: { userId: request.user.id },
          },
        });
        return 1;
      };
      const changedCount = app.prisma.$transaction
        ? await app.prisma.$transaction(persist)
        : await persist(app.prisma);
      if (changedCount !== 1) return reply.code(404).send({ error: { code: 'NOT_FOUND', message: 'Account not found in this organization' } });
      return reply.send({ success: true, ...(await readOwnMonitoringStatus(app.prisma, request.user)) });
    } catch (error) {
      request.log.error({ err: error }, 'Failed to persist self monitoring authorization');
      return reply.code(503).send({ error: { code: 'AUTHORIZATION_SAVE_FAILED', message: 'Monitoring authorization could not be saved' } });
    }
  });

  app.patch('/devices/my-monitoring-schedule', async (request, reply) => {
    const { shiftStart, shiftEnd, workingDays } = request.body || {};
    if (!TIME_RE.test(shiftStart || '') || !TIME_RE.test(shiftEnd || '') || shiftStart === shiftEnd ||
        !Array.isArray(workingDays) || workingDays.length === 0 ||
        workingDays.some((day) => !WORKING_DAYS.includes(day)) || new Set(workingDays).size !== workingDays.length) {
      return reply.code(400).send({ error: { code: 'INVALID_SCHEDULE', message: 'Choose valid working hours and at least one working day. Overnight schedules are supported.' } });
    }
    if (!app.prisma?.user?.updateMany || !app.prisma?.$transaction) {
      return reply.code(503).send({ error: { code: 'STORAGE_UNAVAILABLE', message: 'The monitoring schedule could not be saved' } });
    }
    try {
      const now = new Date();
      const isAdmin = normalizeRole(request.user.role) === Roles.ADMIN;
      const result = await app.prisma.$transaction(async (tx) => {
        if (isAdmin) {
          const organization = await tx.organization.updateMany({
            where: { id: request.user.organizationId },
            data: {
              monitoringShiftStart: shiftStart,
              monitoringShiftEnd: shiftEnd,
              monitoringWorkingDays: workingDays,
              monitoringConfigUpdatedAt: now,
              monitoringConfigUpdatedBy: request.user.email,
            },
          });
          if (organization.count !== 1) return { found: false, syncedUsers: 0 };
          const users = await tx.user.updateMany({
            where: { organizationId: request.user.organizationId, scheduleOverride: false },
            data: { shiftStart, shiftEnd, workingDays, configurationUpdatedAt: now },
          });
          if (tx.auditLog?.create) await tx.auditLog.create({ data: {
            organizationId: request.user.organizationId,
            action: 'ORGANIZATION_MONITORING_SCHEDULE_UPDATED',
            actor: request.user.email,
            details: { shiftStart, shiftEnd, workingDays, inheritedUsersUpdated: users.count },
          } });
          return { found: true, syncedUsers: users.count };
        }

        const changed = await tx.user.updateMany({
          where: { id: request.user.id, organizationId: request.user.organizationId },
          data: { shiftStart, shiftEnd, workingDays, scheduleOverride: true, configurationUpdatedAt: now },
        });
        if (changed.count === 1 && tx.auditLog?.create) await tx.auditLog.create({ data: {
          organizationId: request.user.organizationId,
          action: 'EMPLOYEE_MONITORING_SCHEDULE_UPDATED',
          actor: request.user.email,
          details: { userId: request.user.id, shiftStart, shiftEnd, workingDays },
        } });
        return { found: changed.count === 1, syncedUsers: changed.count };
      });
      if (!result.found) return reply.code(404).send({ error: { code: 'NOT_FOUND', message: isAdmin ? 'Organization not found' : 'Account not found in this organization' } });
      return reply.send({ success: true, syncedUsers: result.syncedUsers, ...(await readOwnMonitoringStatus(app.prisma, request.user)) });
    } catch (error) {
      request.log.error({ err: error }, 'Failed to persist personal monitoring schedule');
      return reply.code(503).send({ error: { code: 'SCHEDULE_SAVE_FAILED', message: 'The monitoring schedule could not be saved' } });
    }
  });

  app.patch('/devices/organization-timezone', {
    preHandler: [authMiddleware.requireRole(Roles.ADMIN)],
  }, async (request, reply) => {
    const timezone = typeof request.body?.timezone === 'string' ? request.body.timezone.trim() : '';
    if (!timezone || timezone.length > 64) {
      return reply.code(400).send({ error: { code: 'INVALID_TIMEZONE', message: 'Enter a valid organization time zone' } });
    }
    try { new Intl.DateTimeFormat('en-US', { timeZone: timezone }); }
    catch { return reply.code(400).send({ error: { code: 'INVALID_TIMEZONE', message: 'Enter a valid IANA time zone, such as Europe/London' } }); }
    if (!request.user.organizationId || !app.prisma?.organization?.updateMany || !app.prisma?.user?.updateMany || !app.prisma?.$transaction) {
      return reply.code(503).send({ error: { code: 'ORGANIZATION_SETTINGS_UNAVAILABLE', message: 'Organization settings could not be saved' } });
    }
    try {
      const now = new Date();
      const result = await app.prisma.$transaction(async (tx) => {
        const changed = await tx.organization.updateMany({
          where: { id: request.user.organizationId },
          data: { timezone, monitoringConfigUpdatedAt: now, monitoringConfigUpdatedBy: request.user.email },
        });
        if (changed.count !== 1) return { found: false, syncedUsers: 0 };
        const users = await tx.user.updateMany({
          where: { organizationId: request.user.organizationId },
          data: { configurationUpdatedAt: now },
        });
        if (tx.auditLog?.create) await tx.auditLog.create({ data: {
          organizationId: request.user.organizationId,
          action: 'ORGANIZATION_TIMEZONE_UPDATED',
          actor: request.user.email,
          details: { timezone, affectedUsers: users.count },
        } });
        return { found: true, syncedUsers: users.count };
      });
      if (!result.found) return reply.code(404).send({ error: { code: 'NOT_FOUND', message: 'Organization not found' } });
      return reply.send({ success: true, timezone, syncedUsers: result.syncedUsers, configurationUpdatedAt: now });
    } catch (error) {
      request.log.error({ err: error }, 'Failed to persist organization time zone');
      return reply.code(503).send({ error: { code: 'ORGANIZATION_SETTINGS_UNAVAILABLE', message: 'Organization time zone could not be saved' } });
    }
  });

  // GET /api/v1/devices (Protected: User authentication, tenant & role scoped)
  app.get('/devices', async (request, reply) => {
    const user = request.user;
    if (!user) {
      return reply.status(401).send({
        error: { code: 'UNAUTHORIZED', message: 'Authentication required' },
      });
    }

    const userRole = normalizeRole(user.role);

    const orgId =
      userRole === Roles.SUPER_ADMIN
        ? request.query?.organizationId
        : user.organizationId;

    if (userRole === Roles.SUPER_ADMIN && !orgId) {
      return reply.code(400).send({
        error: 'ORGANIZATION_SCOPE_REQUIRED',
        message: 'Select an organization to view its devices',
      });
    }

    const targetUserId =
      userRole === Roles.EMPLOYEE ? user.id : null;

    const includeArchived = request.query?.includeArchived === 'true' && [Roles.ADMIN, Roles.SUPER_ADMIN].includes(userRole);
    const devices = await deviceService.listDevices(orgId, targetUserId, { includeArchived });
    const pendingEnrollments = await deviceService.listPendingEnrollments(orgId, targetUserId);
    return reply.send({ devices, totalCount: devices.length, pendingEnrollments });
  });

  // POST /api/v1/devices/enrollment-tokens (Protected: Admin or Super Admin only)
  app.post(
    '/devices/enrollment-tokens',
    { preHandler: [tokenCreationLimiter] },
    async (request, reply) => {
      const user = request.user;
      if (!user) {
        return reply.status(401).send({
          error: { code: 'UNAUTHORIZED', message: 'Authentication required' },
        });
      }

      const userRole = normalizeRole(user.role);

      if (![Roles.ADMIN, Roles.SUPER_ADMIN].includes(userRole)) {
        return reply.code(403).send({
          error: { code: 'FORBIDDEN', message: 'Only administrators can create enrollment tokens' },
        });
      }

      const { userId, deviceKind, expiresInHours } = request.body || {};
      if (deviceKind !== undefined && !['DESKTOP_AGENT', 'BROWSER_EXTENSION'].includes(deviceKind)) {
        return reply.code(400).send({ error: { code: 'INVALID_DEVICE_KIND', message: 'Choose DESKTOP_AGENT or BROWSER_EXTENSION' } });
      }
      const orgId =
        userRole === Roles.SUPER_ADMIN
          ? request.body?.organizationId
          : user.organizationId;

      if (!orgId) {
        return reply.code(400).send({
          error: 'ORGANIZATION_SCOPE_REQUIRED',
          message: 'Organization ID is required',
        });
      }

      try {
        const tokenInfo = await deviceService.createEnrollmentToken({
          organizationId: orgId,
          userId,
          deviceKind,
          expiresInHours,
          createdByUserId: user.id,
        });
        return reply.status(201).send({ success: true, ...tokenInfo });
      } catch (err) {
        return reply.status(err.statusCode || 400).send({
          error: { code: 'TOKEN_CREATION_FAILED', message: err.message },
        });
      }
    },
  );

  // Employees and organization administrators may create a short-lived token
  // only for their own device. Scope always comes from the authenticated user.
  app.post('/devices/my-enrollment-token', {
    preHandler: [tokenCreationLimiter, authMiddleware.requireRole(Roles.EMPLOYEE, Roles.ADMIN)],
  }, async (request, reply) => {
    const role = normalizeRole(request.user?.role);
    if (![Roles.EMPLOYEE, Roles.ADMIN].includes(role)) {
      return reply.code(403).send({ error: { code: 'FORBIDDEN', message: 'Only an employee or organization administrator may enroll their own device' } });
    }
    const { deviceKind } = request.body || {};
    if (!['DESKTOP_AGENT', 'BROWSER_EXTENSION'].includes(deviceKind)) {
      return reply.code(400).send({ error: { code: 'INVALID_DEVICE_KIND', message: 'Choose DESKTOP_AGENT or BROWSER_EXTENSION' } });
    }
    if (!request.user?.organizationId || !request.user?.id || request.user?.employmentStatus === 'disabled') {
      return reply.code(403).send({ error: { code: 'ACCOUNT_SCOPE_REQUIRED', message: 'An active organization account is required' } });
    }
    try {
      const tokenInfo = await deviceService.createEnrollmentToken({
        organizationId: request.user.organizationId,
        userId: request.user.id,
        deviceKind,
        expiresInHours: 4,
        createdByUserId: request.user.id,
      });
      return reply.code(201).send({ success: true, ...tokenInfo });
    } catch (err) {
      return reply.code(err.statusCode || 503).send({ error: { code: 'TOKEN_CREATION_FAILED', message: err.message } });
    }
  });

  app.post('/devices/enrollment-tokens/:tokenId/revoke', async (request, reply) => {
    const role = normalizeRole(request.user?.role);
    if (![Roles.ADMIN, Roles.SUPER_ADMIN].includes(role)) {
      return reply.code(403).send({ error: { code: 'FORBIDDEN', message: 'Only administrators can revoke enrollment tokens' } });
    }
    const organizationId = role === Roles.SUPER_ADMIN
      ? request.body?.organizationId || request.query?.organizationId
      : request.user.organizationId;
    if (!organizationId) {
      return reply.code(400).send({ error: { code: 'ORGANIZATION_SCOPE_REQUIRED', message: 'Select an organization' } });
    }
    try {
      return reply.send(await deviceService.revokeEnrollmentToken(
        request.params.tokenId,
        organizationId,
        request.user.email || request.user.id,
        request.user.id,
      ));
    } catch (error) {
      return reply.code(error.statusCode || 400).send({
        error: { code: error.code || 'TOKEN_REVOCATION_FAILED', message: error.message },
      });
    }
  });

  // POST /api/v1/devices/enroll (Public: Device consumes one-time enrollment token / employee secret key)
  app.post('/devices/enroll', { preHandler: [tokenConsumptionLimiter] }, async (request, reply) => {
    const { secretKey, token, deviceId, name, platform, browser, agentVersion } = request.body || {};
    const clientIp = request.ip || request.headers['x-forwarded-for'] || request.socket?.remoteAddress;
    try {
      const result = await deviceService.enrollDevice({
        secretKey,
        token,
        deviceId,
        name,
        platform,
        browser,
        agentVersion,
        clientIp,
      });
      return reply.status(201).send(result);
    } catch (err) {
      return reply.status(err.statusCode || 400).send({
        error: { code: err.code || 'ENROLLMENT_FAILED', message: err.message },
      });
    }
  });

  // POST /api/v1/devices/issue-secret-key (Protected: Admin or Super Admin only)
  app.post(
    '/devices/issue-secret-key',
    {
      preHandler: [
        tokenCreationLimiter,
        authMiddleware.requireRole(Roles.ADMIN, Roles.SUPER_ADMIN),
      ],
    },
    async (request, reply) => {
      const user = request.user;
      if (!user) {
        return reply.status(401).send({
          error: { code: 'UNAUTHORIZED', message: 'Authentication required' },
        });
      }

      const userRole = normalizeRole(user.role);
      const { userId, deviceKind, expiresInHours } = request.body || {};
      if (!userId) {
        return reply.code(400).send({
          error: { code: 'EMPLOYEE_REQUIRED', message: 'Employee user ID is required to issue an employee secret key' },
        });
      }
      if (deviceKind !== undefined && !['DESKTOP_AGENT', 'BROWSER_EXTENSION'].includes(deviceKind)) {
        return reply.code(400).send({ error: { code: 'INVALID_DEVICE_KIND', message: 'Choose DESKTOP_AGENT or BROWSER_EXTENSION' } });
      }
      const orgId =
        userRole === Roles.SUPER_ADMIN
          ? request.body?.organizationId
          : user.organizationId;

      if (!orgId) {
        return reply.code(400).send({
          error: 'ORGANIZATION_SCOPE_REQUIRED',
          message: 'Organization ID is required',
        });
      }

      try {
        const keyInfo = await deviceService.issueEmployeeSecretKey({
          organizationId: orgId,
          userId,
          deviceKind,
          expiresInHours,
          createdByUserId: user.id,
        });
        return reply.status(201).send({ success: true, ...keyInfo });
      } catch (err) {
        return reply.status(err.statusCode || 400).send({
          error: { code: err.code || 'SECRET_KEY_ISSUANCE_FAILED', message: err.message },
        });
      }
    },
  );

  // POST /api/v1/devices/:id/heartbeat (Protected: Authenticated Device credentials)
  app.post('/devices/:id/heartbeat', async (request, reply) => {
    const { id } = request.params;
    const { agentVersion, metrics } = request.body || {};

    // Extract device secret from header or payload
    const secret =
      request.headers['x-device-secret'] ||
      (request.headers.authorization?.startsWith('Bearer ') && request.headers.authorization.substring(7).trim()) ||
      request.body?.deviceSecret ||
      request.body?.secret;

    if (!secret) {
      return reply.status(401).send({
        error: {
          code: 'UNAUTHORIZED',
          message: 'Device credentials required. Supply X-Device-Secret or Bearer secret',
        },
      });
    }

    try {
      const result = await deviceService.recordHeartbeat(id, secret, { agentVersion, metrics });
      return reply.send(result);
    } catch (err) {
      return reply.status(err.statusCode || 400).send({
        error: { code: err.code || 'HEARTBEAT_FAILED', message: err.message },
      });
    }
  });

  // POST /api/v1/devices/:id/revoke (Protected: Admin only, tenant-scoped)
  app.post(
    '/devices/:id/revoke',
    async (request, reply) => {
      const user = request.user;
      if (!user) {
        return reply.status(401).send({
          error: { code: 'UNAUTHORIZED', message: 'Authentication required' },
        });
      }

      const userRole = normalizeRole(user.role);

      if (![Roles.ADMIN, Roles.SUPER_ADMIN].includes(userRole)) {
        return reply.code(403).send({
          error: 'FORBIDDEN',
          message: 'Only administrators can revoke devices',
        });
      }

      const { id } = request.params;
      const orgId =
        userRole === Roles.SUPER_ADMIN
          ? null
          : user.organizationId;

      try {
        const reason = request.body?.reason;
        if (reason !== undefined && (typeof reason !== 'string' || reason.trim().length > 500)) {
          return reply.code(400).send({ error: { code: 'INVALID_REASON', message: 'Revocation reason must be at most 500 characters' } });
        }
        const result = await deviceService.revokeDevice(id, orgId, user.email || user.displayName || 'Administrator', reason, user.id);
        return reply.send(result);
      } catch (err) {
        return reply.status(err.statusCode || 400).send({
          error: { code: 'REVOCATION_FAILED', message: err.message },
        });
      }
    },
  );

  app.post('/devices/:id/archive', async (request, reply) => {
    const role = normalizeRole(request.user?.role);
    if (![Roles.ADMIN, Roles.SUPER_ADMIN].includes(role)) return reply.code(403).send({ error: { code: 'FORBIDDEN', message: 'Only administrators can archive devices' } });
    const reason = request.body?.reason;
    if (reason !== undefined && (typeof reason !== 'string' || reason.trim().length > 500)) return reply.code(400).send({ error: { code: 'INVALID_REASON', message: 'Archive reason must be at most 500 characters' } });
    const organizationId = role === Roles.SUPER_ADMIN ? null : request.user.organizationId;
    try {
      return reply.send(await deviceService.archiveDevice(request.params.id, organizationId, request.user.email || request.user.id, reason, request.user.id));
    } catch (error) {
      return reply.code(error.statusCode || 400).send({ error: { code: error.code || 'ARCHIVE_FAILED', message: error.message } });
    }
  });

  app.post('/devices/:id/restore', async (request, reply) => {
    const role = normalizeRole(request.user?.role);
    if (![Roles.ADMIN, Roles.SUPER_ADMIN].includes(role)) return reply.code(403).send({ error: { code: 'FORBIDDEN', message: 'Only administrators can restore devices' } });
    const organizationId = role === Roles.SUPER_ADMIN ? null : request.user.organizationId;
    try {
      return reply.send(await deviceService.restoreDevice(request.params.id, organizationId, request.user.email || request.user.id, request.user.id));
    } catch (error) {
      return reply.code(error.statusCode || 400).send({ error: { code: error.code || 'RESTORE_FAILED', message: error.message } });
    }
  });

  app.get('/devices/duplicate-review', async (request, reply) => {
    const role = normalizeRole(request.user?.role);
    if (![Roles.ADMIN, Roles.SUPER_ADMIN].includes(role)) return reply.code(403).send({ error: { code: 'FORBIDDEN', message: 'Only administrators can review duplicate devices' } });
    const organizationId = role === Roles.SUPER_ADMIN ? request.query?.organizationId : request.user.organizationId;
    if (!organizationId) return reply.code(400).send({ error: { code: 'ORGANIZATION_SCOPE_REQUIRED', message: 'Select an organization' } });
    return reply.send({ candidates: await deviceService.reviewDuplicateCandidates(organizationId) });
  });

  app.get('/devices/:id/audit', async (request, reply) => {
    const role = normalizeRole(request.user?.role);
    if (![Roles.ADMIN, Roles.SUPER_ADMIN].includes(role)) return reply.code(403).send({ error: { code: 'FORBIDDEN', message: 'Only administrators can view device audit history' } });
    const organizationId = role === Roles.SUPER_ADMIN ? request.query?.organizationId : request.user.organizationId;
    if (!organizationId) return reply.code(400).send({ error: { code: 'ORGANIZATION_SCOPE_REQUIRED', message: 'Select an organization' } });
    try {
      return reply.send({ events: await deviceService.listDeviceAudit(request.params.id, organizationId) });
    } catch (error) {
      return reply.code(error.statusCode || 400).send({ error: { code: 'DEVICE_AUDIT_FAILED', message: error.message } });
    }
  });

  app.get('/devices/:id', async (request, reply) => {
    const role = normalizeRole(request.user?.role);
    const organizationId = role === Roles.SUPER_ADMIN ? request.query?.organizationId : request.user.organizationId;
    if (!organizationId) return reply.code(400).send({ error: { code: 'ORGANIZATION_SCOPE_REQUIRED', message: 'Select an organization' } });
    try {
      const device = await deviceService.getDeviceDetails(request.params.id, organizationId);
      if (role === Roles.EMPLOYEE && device?.userId !== request.user.id) return reply.code(403).send({ error: { code: 'FORBIDDEN', message: 'Employees may only view their own devices' } });
      return reply.send({ device });
    } catch (error) {
      return reply.code(error.statusCode || 400).send({ error: { code: 'DEVICE_DETAILS_FAILED', message: error.message } });
    }
  });

  app.post('/devices/bulk-actions', async (request, reply) => {
    const role = normalizeRole(request.user?.role);
    if (![Roles.ADMIN, Roles.SUPER_ADMIN].includes(role)) return reply.code(403).send({ error: { code: 'FORBIDDEN', message: 'Only administrators can manage devices in bulk' } });
    const deviceIds = [...new Set(Array.isArray(request.body?.deviceIds) ? request.body.deviceIds : [])];
    const action = String(request.body?.action || '').toLowerCase();
    const reason = request.body?.reason;
    if (!deviceIds.length || deviceIds.length > 100 || deviceIds.some((id) => typeof id !== 'string')) return reply.code(400).send({ error: { code: 'INVALID_DEVICE_SELECTION', message: 'Select between 1 and 100 devices' } });
    if (!['revoke', 'archive'].includes(action)) return reply.code(400).send({ error: { code: 'INVALID_BULK_ACTION', message: 'Choose revoke or archive' } });
    if (reason !== undefined && (typeof reason !== 'string' || reason.trim().length > 500)) return reply.code(400).send({ error: { code: 'INVALID_REASON', message: 'Reason must be at most 500 characters' } });
    const organizationId = role === Roles.SUPER_ADMIN ? request.body?.organizationId || null : request.user.organizationId;
    const actor = request.user.email || request.user.id;
    const results = [];
    for (const deviceId of deviceIds) {
      try {
        const result = action === 'revoke'
          ? await deviceService.revokeDevice(deviceId, organizationId, actor, reason, request.user.id)
          : await deviceService.archiveDevice(deviceId, organizationId, actor, reason, request.user.id);
        results.push({ deviceId, success: true, lifecycleStatus: result.lifecycleStatus });
      } catch (error) {
        results.push({ deviceId, success: false, code: error.code || 'DEVICE_ACTION_FAILED', message: error.message });
      }
    }
    return reply.send({ success: results.every((result) => result.success), action, results });
  });

  // POST /api/v1/devices/:id/rotate-secret (Protected: Admin or Authenticated Device)
  app.post('/devices/:id/rotate-secret', async (request, reply) => {
    const { id } = request.params;
    const user = request.user;
    const secret =
      request.headers['x-device-secret'] ||
      (request.headers.authorization?.startsWith('Bearer ') && request.headers.authorization.substring(7).trim()) ||
      request.body?.deviceSecret ||
      request.body?.secret;

    const userRole = user ? normalizeRole(user.role) : null;

    const isUserAdmin =
      user && [Roles.ADMIN, Roles.SUPER_ADMIN].includes(userRole);

    const orgId = isUserAdmin
      ? userRole === Roles.SUPER_ADMIN
        ? null
        : user.organizationId
      : user?.organizationId;

    if (!isUserAdmin && !secret) {
      return reply.status(401).send({
        error: { code: 'UNAUTHORIZED', message: 'Current device secret or admin session required for rotation' },
      });
    }

    try {
      const result = await deviceService.rotateDeviceSecret(id, orgId, secret, isUserAdmin);
      return reply.send(result);
    } catch (err) {
      return reply.status(err.statusCode || 400).send({
        error: { code: 'ROTATION_FAILED', message: err.message },
      });
    }
  });
}
