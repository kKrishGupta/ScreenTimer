# DigitalPulse backend configuration (copy to .env and adjust).
# Use HOST=0.0.0.0 and a LAN URL only when testing from another device.

NODE_ENV=development
HOST=127.0.0.1
PORT=3001
LOG_LEVEL=info

# PostgreSQL 18 on this machine listens on port 5433.
# Create the role/database with: scripts\setup-database.ps1
DATABASE_URL=postgresql://digitalpulse:CHANGE_ME@127.0.0.1:5433/digitalpulse?schema=public
DATABASE_POOL_MAX=5

# Comma-separated list of allowed dashboard origins.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
INVITATION_ACCEPT_URL=http://localhost:5173/accept-invitation

# Slug of the single local development organization created by `npm run db:seed`.
DEV_ORG_SLUG=local-dev

# Gmail SMTP (use a Google App Password, never the normal account password).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
PASSWORD_RESET_URL=http://localhost:5173/reset-password
# Reset links expire after this many minutes (1-60). A configured email provider is required to deliver them.
PASSWORD_RESET_TTL_MINUTES=30
# Public API origin embedded in extension builds.
EXTENSION_BACKEND_URL=http://127.0.0.1:3001
EXTENSION_LOCAL_BACKEND_URL=http://127.0.0.1:3001
EXTENSION_PRODUCTION_BACKEND_URL=https://api.example.com

# Private screenshot storage. Use "cloudinary" for deployed environments or
# "local" for AES-256-GCM encrypted development storage.
SCREENSHOT_STORAGE_PROVIDER=cloudinary
SCREENSHOT_ENCRYPTION_KEY=replace-with-a-random-secret-at-least-32-characters
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Used only when SCREENSHOT_STORAGE_PROVIDER=local:
# SCREENSHOT_STORAGE_DIR=./storage/screenshots
