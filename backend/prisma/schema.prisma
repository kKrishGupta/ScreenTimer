// DigitalPulse PostgreSQL schema (Stage 1).
//
// Conventions:
// * UUID primary keys generated by PostgreSQL (gen_random_uuid()).
// * All timestamps are timestamptz and written in UTC.
// * Every tenant-owned row carries organizationId so Stage 2 multi-tenancy is additive.
// * ActivityEvent is the immutable, idempotent raw ingest log (unique per device + eventId).
//   ActivitySession is the normalised, queryable projection used by the dashboard.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum CollectorKind {
  DESKTOP_AGENT     @map("desktop_agent")
  BROWSER_EXTENSION @map("browser_extension")

  @@map("collector_kind")
}

enum ActivityType {
  APP_SESSION  @map("app_session")
  WEB_SESSION  @map("web_session")
  IDLE_SESSION @map("idle_session")

  @@map("activity_type")
}

enum UserRole {
  SUPER_ADMIN @map("super_admin")
  ADMIN       @map("admin")
  EMPLOYEE    @map("employee")

  @@map("user_role")
}

enum GraceStatus {
  NOT_VISITED  @map("not_visited")
  GRACE_ACTIVE @map("grace_active")
  BLOCKED      @map("blocked")
  ADMIN_RESET  @map("admin_reset")

  @@map("grace_status")
}

model Organization {
  id                        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                      String    @db.VarChar(128)
  slug                      String    @unique @db.VarChar(64)
  timezone                  String?   @db.VarChar(64)
  monitoringShiftStart      String?   @map("monitoring_shift_start") @db.VarChar(16)
  monitoringShiftEnd        String?   @map("monitoring_shift_end") @db.VarChar(16)
  monitoringWorkingDays     String[]  @default(["Mon", "Tue", "Wed", "Thu", "Fri"]) @map("monitoring_working_days")
  monitoringConfigUpdatedAt DateTime? @map("monitoring_config_updated_at") @db.Timestamptz(3)
  monitoringConfigUpdatedBy String?   @map("monitoring_config_updated_by") @db.VarChar(254)
  createdAt                 DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                 DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  users            User[]
  sites            Site[]
  departments      Department[]
  graceGrants      GraceGrant[]
  devices          Device[]
  applications     Application[]
  websites         Website[]
  events           ActivityEvent[]
  sessions         ActivitySession[]
  dailySummaries   DailySummary[]
  screenCaptures   ScreenCaptureMetadata[]
  screenShares     ScreenShareSession[]
  screenMonitoring ScreenMonitoringSetting?
  plannerTasks     PlannerTask[]
  focusSessions    FocusSession[]
  policies         FamilyPolicy[]
  violations       PolicyViolation[]
  auditLogs        AuditLog[]
  enrollmentTokens DeviceEnrollmentToken[]
  invitations      Invitation[]
  notifications    Notification[]
  usageCategories  UsageCategory[]

  @@map("organizations")
}

model Site {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  name           String   @db.VarChar(128)
  location       String?  @db.VarChar(256)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  departments  Department[]

  @@unique([organizationId, name])
  @@map("sites")
}

model Department {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  siteId         String?  @map("site_id") @db.Uuid
  name           String   @db.VarChar(128)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  site         Site?        @relation(fields: [siteId], references: [id], onDelete: SetNull)
  users        User[]

  @@unique([organizationId, name])
  @@map("departments")
}

model User {
  id                             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId                 String    @map("organization_id") @db.Uuid
  departmentId                   String?   @map("department_id") @db.Uuid
  email                          String    @db.VarChar(254)
  displayName                    String    @map("display_name") @db.VarChar(128)
  role                           UserRole  @default(EMPLOYEE)
  passwordHash                   String?   @map("password_hash") @db.VarChar(256)
  passwordSalt                   String?   @map("password_salt") @db.VarChar(128)
  employeeNumber                 String?   @map("employee_number") @db.VarChar(64)
  managerId                      String?   @map("manager_id") @db.Uuid
  designation                    String?   @db.VarChar(128)
  workLocation                   String?   @map("work_location") @db.VarChar(128)
  shiftStart                     String?   @map("shift_start") @db.VarChar(16)
  shiftEnd                       String?   @map("shift_end") @db.VarChar(16)
  shiftTimezone                  String?   @map("shift_timezone") @db.VarChar(64)
  workingDays                    String[]  @default(["Mon", "Tue", "Wed", "Thu", "Fri"]) @map("working_days")
  scheduleOverride               Boolean   @default(false) @map("schedule_override")
  configurationUpdatedAt         DateTime? @map("configuration_updated_at") @db.Timestamptz(3)
  employmentStatus               String    @default("active") @map("employment_status") @db.VarChar(32)
  monitoringAuthorized           Boolean   @default(false) @map("monitoring_authorized")
  monitoringConsentAt            DateTime? @map("monitoring_consent_at") @db.Timestamptz(3)
  monitoringConsentRevokedAt     DateTime? @map("monitoring_consent_revoked_at") @db.Timestamptz(3)
  monitoringConsentVersion       String?   @map("monitoring_consent_version") @db.VarChar(64)
  screenMonitoringAcknowledgedAt DateTime? @map("screen_monitoring_acknowledged_at") @db.Timestamptz(3)
  metadata                       Json?     @db.JsonB
  createdAt                      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization     Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  department       Department?             @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  manager          User?                   @relation("ManagerEmployees", fields: [managerId], references: [id], onDelete: SetNull)
  subordinates     User[]                  @relation("ManagerEmployees")
  devices          Device[]
  plannerTasks     PlannerTask[]
  focusSessions    FocusSession[]
  sessions         UserSession[]
  enrollmentTokens DeviceEnrollmentToken[]
  graceGrants      GraceGrant[]
  resetTokens      PasswordResetToken[]
  violations       PolicyViolation[]
  notifications    Notification[]
  screenCaptures   ScreenCaptureMetadata[]

  @@unique([organizationId, email])
  @@map("users")
}

model GraceGrant {
  id             String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String      @map("organization_id") @db.Uuid
  userId         String?     @map("user_id") @db.Uuid
  deviceId       String?     @map("device_id") @db.Uuid
  domain         String      @db.VarChar(253)
  status         GraceStatus @default(NOT_VISITED)
  graceMinutes   Int         @default(15) @map("grace_minutes")
  firstVisitedAt DateTime?   @map("first_visited_at") @db.Timestamptz(3)
  expiresAt      DateTime?   @map("expires_at") @db.Timestamptz(3)
  calendarDate   DateTime    @default(now()) @map("calendar_date") @db.Date
  resetBy        String?     @map("reset_by") @db.VarChar(128)
  resetAt        DateTime?   @map("reset_at") @db.Timestamptz(3)
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([organizationId, domain, calendarDate])
  @@index([organizationId, status])
  @@map("grace_grants")
}

model UserSession {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.VarChar(64)
  userAgent String?   @map("user_agent") @db.VarChar(256)
  ipAddress String?   @map("ip_address") @db.VarChar(45)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("user_sessions")
}

model LoginAttempt {
  identifierHash String    @id @map("identifier_hash") @db.VarChar(64)
  failureCount   Int       @default(0) @map("failure_count")
  firstFailedAt  DateTime  @map("first_failed_at") @db.Timestamptz(3)
  lockedUntil    DateTime? @map("locked_until") @db.Timestamptz(3)
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([updatedAt])
  @@map("login_attempts")
}

model DeviceEnrollmentToken {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  token          String?       @unique @db.VarChar(128)
  tokenHash      String?       @unique @map("token_hash") @db.VarChar(64)
  organizationId String        @map("organization_id") @db.Uuid
  userId         String?       @map("user_id") @db.Uuid
  deviceKind     CollectorKind @map("device_kind")
  expiresAt      DateTime      @map("expires_at") @db.Timestamptz(3)
  usedAt         DateTime?     @map("used_at") @db.Timestamptz(3)
  revokedAt      DateTime?     @map("revoked_at") @db.Timestamptz(3)
  createdByUserId String?       @map("created_by_user_id") @db.Uuid
  consumedByDeviceId String?    @map("consumed_by_device_id") @db.Uuid
  maxUses        Int           @default(1) @map("max_uses")
  useCount       Int           @default(0) @map("use_count")
  expiryRecordedAt DateTime?    @map("expiry_recorded_at") @db.Timestamptz(3)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([token])
  @@index([organizationId])
  @@index([createdByUserId])
  @@index([consumedByDeviceId])
  @@map("device_enrollment_tokens")
}

model Device {
  // The id is generated by the collector (desktop agent or browser extension installation)
  // so that offline-collected events can reference it before first contact.
  id                         String        @id @db.Uuid
  organizationId             String        @map("organization_id") @db.Uuid
  userId                     String?       @map("user_id") @db.Uuid
  kind                       CollectorKind
  name                       String        @db.VarChar(128)
  platform                   String        @db.VarChar(64)
  browser                    String?       @db.VarChar(16)
  agentVersion               String?       @map("agent_version") @db.VarChar(32)
  secretHash                 String?       @map("secret_hash") @db.VarChar(256)
  secretSalt                 String?       @map("secret_salt") @db.VarChar(128)
  isRevoked                  Boolean       @default(false) @map("is_revoked")
  revokedAt                  DateTime?     @map("revoked_at") @db.Timestamptz(3)
  revokedByUserId            String?       @map("revoked_by_user_id") @db.Uuid
  revocationReason           String?       @map("revocation_reason") @db.VarChar(500)
  archivedAt                 DateTime?     @map("archived_at") @db.Timestamptz(3)
  archivedByUserId           String?       @map("archived_by_user_id") @db.Uuid
  archiveReason              String?       @map("archive_reason") @db.VarChar(500)
  deletedAt                  DateTime?     @map("deleted_at") @db.Timestamptz(3)
  deletedByUserId            String?       @map("deleted_by_user_id") @db.Uuid
  lastSeenAt                 DateTime?     @map("last_seen_at") @db.Timestamptz(3)
  lastSyncAt                 DateTime?     @map("last_sync_at") @db.Timestamptz(3)
  screenCaptureEnabled       Boolean       @default(false) @map("screen_capture_enabled")
  lastScreenCaptureAt        DateTime?     @map("last_screen_capture_at") @db.Timestamptz(3)
  lastScreenCaptureFailureAt DateTime?     @map("last_screen_capture_failure_at") @db.Timestamptz(3)
  lastScreenCaptureError     String?       @map("last_screen_capture_error") @db.VarChar(128)
  createdAt                  DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                  DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization   Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User?                   @relation(fields: [userId], references: [id], onDelete: SetNull)
  events         ActivityEvent[]
  sessions       ActivitySession[]
  dailySummaries DailySummary[]
  screenCaptures ScreenCaptureMetadata[]
  screenShares   ScreenShareSession[]
  violations     PolicyViolation[]

  @@index([organizationId])
  @@index([userId])
  @@index([organizationId, archivedAt])
  @@index([organizationId, isRevoked])
  @@index([organizationId, deletedAt])
  @@map("devices")
}

model Application {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  // Lower-cased executable name (e.g. "code.exe") is the identity key.
  executableName String   @map("executable_name") @db.VarChar(260)
  displayName    String   @map("display_name") @db.VarChar(256)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sessions     ActivitySession[]

  @@unique([organizationId, executableName])
  @@map("applications")
}

model Website {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  domain         String   @db.VarChar(253)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sessions     ActivitySession[]

  @@unique([organizationId, domain])
  @@map("websites")
}

model ActivityEvent {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String        @map("organization_id") @db.Uuid
  deviceId       String        @map("device_id") @db.Uuid
  // Client-generated idempotency key.
  eventId        String        @map("event_id") @db.Uuid
  schemaVersion  Int           @map("schema_version") @db.SmallInt
  source         CollectorKind
  type           ActivityType
  payload        Json          @db.JsonB
  receivedAt     DateTime      @default(now()) @map("received_at") @db.Timestamptz(3)

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  device       Device           @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  session      ActivitySession?

  @@unique([deviceId, eventId])
  @@index([organizationId, receivedAt])
  @@map("activity_events")
}

model ActivitySession {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId  String        @map("organization_id") @db.Uuid
  deviceId        String        @map("device_id") @db.Uuid
  activityEventId String        @unique @map("activity_event_id") @db.Uuid
  type            ActivityType
  source          CollectorKind
  applicationId   String?       @map("application_id") @db.Uuid
  websiteId       String?       @map("website_id") @db.Uuid
  processId       Int?          @map("process_id")
  browser         String?       @db.VarChar(16)
  startedAt       DateTime      @map("started_at") @db.Timestamptz(3)
  endedAt         DateTime      @map("ended_at") @db.Timestamptz(3)
  durationSeconds Float         @map("duration_seconds")
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  device       Device        @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  event        ActivityEvent @relation(fields: [activityEventId], references: [id], onDelete: Cascade)
  application  Application?  @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  website      Website?      @relation(fields: [websiteId], references: [id], onDelete: SetNull)

  @@index([organizationId, startedAt(sort: Desc)])
  @@index([deviceId, startedAt(sort: Desc)])
  @@index([applicationId, startedAt])
  @@index([websiteId, startedAt])
  @@map("activity_sessions")
}

model DailySummary {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  deviceId       String   @map("device_id") @db.Uuid
  // Calendar day (UTC) the totals apply to.
  day            DateTime @db.Date
  activeSeconds  Float    @default(0) @map("active_seconds")
  idleSeconds    Float    @default(0) @map("idle_seconds")
  appSeconds     Float    @default(0) @map("app_seconds")
  webSeconds     Float    @default(0) @map("web_seconds")
  sessionCount   Int      @default(0) @map("session_count")
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  device       Device       @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@unique([deviceId, day])
  @@index([organizationId, day])
  @@map("daily_summaries")
}

model ScreenCaptureMetadata {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId  String   @map("organization_id") @db.Uuid
  employeeId      String?  @map("employee_id") @db.Uuid
  deviceId        String   @map("device_id") @db.Uuid
  captureKey      String   @map("capture_key") @db.VarChar(128)
  storageKey      String?  @map("storage_key") @db.VarChar(512)
  filePath        String?  @map("file_path") @db.VarChar(512)
  applicationName String   @map("application_name") @db.VarChar(128)
  mimeType        String   @default("image/jpeg") @map("mime_type") @db.VarChar(64)
  sizeBytes       Int      @default(0) @map("size_bytes")
  width           Int      @default(1920)
  height          Int      @default(1080)
  blurred         Boolean  @default(false)
  captureStatus   String   @default("stored") @map("capture_status") @db.VarChar(32)
  failureCode     String?  @map("failure_code") @db.VarChar(128)
  capturedAt      DateTime @default(now()) @map("captured_at") @db.Timestamptz(3)
  expiresAt       DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employee     User?        @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  device       Device       @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@unique([deviceId, captureKey])
  @@index([organizationId, capturedAt])
  @@index([organizationId, deviceId, capturedAt])
  @@index([organizationId, employeeId, capturedAt])
  @@index([employeeId, capturedAt])
  @@index([expiresAt])
  @@map("screen_captures")
}

model ScreenMonitoringSetting {
  id                     String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId         String   @unique @map("organization_id") @db.Uuid
  enabled                Boolean  @default(false)
  captureIntervalSeconds Int      @default(300) @map("capture_interval_seconds")
  retentionDays          Int      @default(30) @map("retention_days")
  workingDays            String[] @default(["Mon", "Tue", "Wed", "Thu", "Fri"]) @map("working_days")
  shiftStart             String   @default("09:00") @map("shift_start") @db.VarChar(5)
  shiftEnd               String   @default("18:00") @map("shift_end") @db.VarChar(5)
  excludedApplications   String[] @default([]) @map("excluded_applications")
  updatedBy              String?  @map("updated_by") @db.VarChar(128)
  createdAt              DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("screen_monitoring_settings")
}

model ScreenShareSession {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId  String   @map("organization_id") @db.Uuid
  deviceId        String   @map("device_id") @db.Uuid
  sessionToken    String   @unique @map("session_token") @db.VarChar(128)
  active          Boolean  @default(true)
  durationMinutes Int      @default(15) @map("duration_minutes")
  startedAt       DateTime @default(now()) @map("started_at") @db.Timestamptz(3)
  expiresAt       DateTime @map("expires_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  device       Device       @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@map("screen_share_sessions")
}

model PlannerTask {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  userId         String?  @map("user_id") @db.Uuid
  title          String   @db.VarChar(200)
  category       String   @default("general") @db.VarChar(64)
  targetMinutes  Int      @default(30) @map("target_minutes")
  completed      Boolean  @default(false)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId, completed])
  @@map("planner_tasks")
}

model FocusSession {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId  String   @map("organization_id") @db.Uuid
  userId          String?  @map("user_id") @db.Uuid
  title           String   @db.VarChar(128)
  durationMinutes Int      @map("duration_minutes")
  startedAt       DateTime @default(now()) @map("started_at") @db.Timestamptz(3)
  expiresAt       DateTime @map("expires_at") @db.Timestamptz(3)
  completed       Boolean  @default(false)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("focus_sessions")
}

model FamilyPolicy {
  id                      String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId          String   @map("organization_id") @db.Uuid
  name                    String   @db.VarChar(128)
  category                String   @db.VarChar(64)
  restrictedDomains       String[] @map("restricted_domains")
  restrictedApps          String[] @default([]) @map("restricted_apps")
  allowedDomains          String[] @map("allowed_domains")
  maxMinutesPerDay        Int      @default(60) @map("max_minutes_per_day")
  warningThresholdPercent Int      @default(80) @map("warning_threshold_percent")
  action                  String   @default("warn") @db.VarChar(32)
  active                  Boolean  @default(true)
  createdAt               DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt               DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  violations   PolicyViolation[]

  @@map("family_policies")
}

model PolicyViolation {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  policyId       String?  @map("policy_id") @db.Uuid
  deviceId       String?  @map("device_id") @db.Uuid
  userId         String?  @map("user_id") @db.Uuid
  target         String   @db.VarChar(255)
  targetType     String   @map("target_type") @db.VarChar(32)
  severity       String   @default("warning") @db.VarChar(32)
  warningMessage String   @map("warning_message") @db.VarChar(512)
  actionTaken    String?  @map("action_taken") @db.VarChar(64)
  acknowledged   Boolean  @default(false)
  timestamp      DateTime @default(now()) @db.Timestamptz(3)

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  policy       FamilyPolicy? @relation(fields: [policyId], references: [id], onDelete: SetNull)
  device       Device?       @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  user         User?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId, acknowledged])
  @@map("policy_violations")
}

model Invitation {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  token          String?   @unique @db.VarChar(128)
  tokenHash      String?   @unique @map("token_hash") @db.VarChar(256)
  organizationId String    @map("organization_id") @db.Uuid
  email          String    @db.VarChar(254)
  role           UserRole  @default(EMPLOYEE)
  departmentId   String?   @map("department_id") @db.Uuid
  displayName    String?   @map("display_name") @db.VarChar(128)
  shiftStart     String?   @map("shift_start") @db.VarChar(16)
  shiftEnd       String?   @map("shift_end") @db.VarChar(16)
  workingDays    String[]  @default(["Mon", "Tue", "Wed", "Thu", "Fri"]) @map("working_days")
  shiftTimezone  String?   @map("shift_timezone") @db.VarChar(64)
  invitedBy      String?   @map("invited_by") @db.VarChar(128)
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz(3)
  acceptedAt     DateTime? @map("accepted_at") @db.Timestamptz(3)
  revokedAt      DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([token])
  @@map("invitations")
}

model PasswordResetToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.VarChar(256)
  userId    String    @map("user_id") @db.Uuid
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model AuditLog {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  action         String   @db.VarChar(64)
  actor          String   @default("local_user") @db.VarChar(128)
  details        Json?    @db.JsonB
  timestamp      DateTime @default(now()) @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, timestamp])
  @@map("audit_logs")
}

model Notification {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  userId         String?   @map("user_id") @db.Uuid
  type           String    @db.VarChar(64)
  severity       String    @default("info") @db.VarChar(16)
  title          String    @db.VarChar(120)
  message        String    @db.VarChar(500)
  target         String?   @db.VarChar(100)
  read           Boolean   @default(false)
  readAt         DateTime? @map("read_at") @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId, read, createdAt])
  @@index([organizationId, userId, createdAt])
  @@map("notifications")
}

model UsageCategory {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  target         String   @db.VarChar(253)
  targetType     String   @map("target_type") @db.VarChar(16)
  category       String   @db.VarChar(16)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, target, targetType])
  @@index([organizationId, category])
  @@map("usage_categories")
}
