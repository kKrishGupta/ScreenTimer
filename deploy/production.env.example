# Copy this to the repository root as .env.production and replace placeholders.
# Never commit the copied file or put secrets in this example.
PUBLIC_APP_DOMAIN=app.yourdomain.example
PUBLIC_APP_URL=https://app.yourdomain.example
CORS_ORIGINS=https://app.yourdomain.example

# Cloudinary authenticated screenshot storage. Never expose the API secret to
# the dashboard, browser extension, or desktop agent.
SCREENSHOT_STORAGE_PROVIDER=cloudinary
SCREENSHOT_ENCRYPTION_KEY=replace-with-a-production-random-secret-at-least-32-characters
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
DATABASE_URL=postgresql://USER:PASSWORD@POSTGRES_HOST:5432/DATABASE?sslmode=require

# Keep SMTP empty only if invitation and password-reset emails should be unavailable.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=

LOG_LEVEL=info
HTTP_PORT=80
HTTPS_PORT=443
